# Copie este arquivo para .env.local e preencha com suas chaves.
# O .env.local NAO vai para o Git (veja .gitignore).
#
# Em producao (Vercel), cadastre estas mesmas variaveis em
# Settings > Environment Variables e faca um Redeploy.

# Supabase > Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Settings > API Keys > chave "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# brapi.dev > Dashboard > Chaves de API
BRAPI_TOKEN=
