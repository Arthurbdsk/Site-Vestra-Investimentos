# Copie este arquivo para .env.local e preencha com suas chaves.
# O .env.local NAO vai para o Git (veja .gitignore).
#
# Em producao (Vercel), cadastre estas mesmas variaveis em
# Settings > Environment Variables e faca um Redeploy.

# Supabase > Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Settings > API Keys > chave "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# brapi.dev > Dashboard > Chaves de API
BRAPI_TOKEN=

# O token da marketaux.com NAO fica mais aqui, vive na tabela
# public.segredos do Supabase (chave 'marketaux_token'), lido de dentro
# da funcao buscar_noticias(). Pra trocar o token, atualize direto no banco.

# aistudio.google.com/app/apikey (usado pelo agente de investimento em
# /simulador, tier gratuito do Google AI Studio, sem cartao de credito)
GEMINI_API_KEY=
